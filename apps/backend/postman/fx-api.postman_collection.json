    {
      "name": "Rates op datum",
      "item": [
        {
          "name": "Handelsdag, USD naar EUR en GBP",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rates/2024-01-15?base=USD&symbols=EUR,GBP",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rates",
                "2024-01-15"
              ],
              "query": [
                {
                  "key": "base",
                  "value": "USD"
                },
                {
                  "key": "symbols",
                  "value": "EUR,GBP"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);",
                  "pm.test(\"Cache-Control is public\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.match(/public, max-age=\\d+/));",
                  "const body = pm.response.json();",
                  "pm.test(\"koersset heeft base, requested_date, date en rates\", () => {",
                  "  pm.expect(body).to.include.all.keys(\"base\", \"requested_date\", \"date\", \"rates\");",
                  "  pm.expect(body.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "  for (const [code, rate] of Object.entries(body.rates)) {",
                  "    pm.expect(code).to.match(/^[A-Z]{3}$/);",
                  "    pm.expect(rate, code).to.be.a(\"string\").and.match(/^\\d+\\.\\d{6}$/);",
                  "  }",
                  "});",
                  "pm.test(\"datum is de gevraagde datum\", () => pm.expect(pm.response.json().date).to.equal(\"2024-01-15\"));",
                  "pm.test(\"precies EUR en GBP\", () => pm.expect(Object.keys(pm.response.json().rates).sort()).to.deep.equal([\"EUR\", \"GBP\"]));",
                  "pm.test(\"USD naar EUR ligt rond 0.91\", () => pm.expect(Number(pm.response.json().rates.EUR)).to.be.within(0.85, 0.95));"
                ]
              }
            }
          ]
        },

                  "    pm.expect(rate, code).to.be.a(\"string\").and.match(/^\\d+\\.\\d{6}$/);",
                  "  }",
                  "});",
                  "pm.test(\"date is maximaal 5 dagen oud\", () => {",
                  "  const ageDays = (Date.now() - new Date(pm.response.json().date)) / 86400000;",
                  "  pm.expect(ageDays).to.be.below(5);",
                  "});"
                ]
              }
            }
          ]

{
  "info": {
    "name": "FX API",
    "description": "Eigen valuta-API op basis van ECB-referentiekoersen. Zet `baseUrl` in de collectievariabelen of een environment. Elke request heeft tests; gebruik de Collection Runner om alles in een keer te draaien.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333"
    }
  ],
  "item": [
    {
      "name": "Currencies",
      "item": [
        {
          "name": "Alle valuta met koersen",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/currencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "currencies"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);",
                  "pm.test(\"Cache-Control is public\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.match(/public, max-age=\\d+/));",
                  "const body = pm.response.json();",
                  "pm.test(\"data is een array met valuta-objecten\", () => {",
                  "  pm.expect(body.data).to.be.an(\"array\").that.is.not.empty;",
                  "  for (const c of body.data) {",
                  "    pm.expect(c).to.have.all.keys(\"code\", \"name\", \"is_active\", \"first_date\", \"last_date\");",
                  "    pm.expect(c.code).to.match(/^[A-Z]{3}$/);",
                  "    pm.expect(c.first_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "  }",
                  "});",
                  "pm.test(\"gesorteerd op code\", () => {",
                  "  const codes = body.data.map((c) => c.code);",
                  "  pm.expect(codes).to.deep.equal([...codes].sort());",
                  "});"
                ]
              }
            }
          ]
        },
        {
